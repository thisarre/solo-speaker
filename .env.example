NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Personal access token from app.supabase.com/account/tokens — used by scripts/apply-email-templates.ts
SUPABASE_MANAGEMENT_API_TOKEN=sbp_your-personal-access-token
SUPABASE_ADMIN_SIGNUPS=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_STRICT=true
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_GENERATE=12
AI_RATE_LIMIT_SPEAK=8
AI_RATE_LIMIT_TRANSCRIBE=6
AI_RATE_LIMIT_HELP_CHAT=20
AI_RATE_LIMIT_DEEPGRAM_TOKEN=30
DEEPGRAM_API_KEY=dg-your-deepgram-api-key
NEXT_PUBLIC_DEEPGRAM_MODEL=nova-3
STRIPE_SECRET_KEY=sk_test_or_live_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Prices are resolved at runtime by Stripe lookup_key (studio_monthly, studio_yearly,
# pro_monthly, pro_yearly, team_monthly, team_yearly) — no per-price env vars needed.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
