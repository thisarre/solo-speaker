# Automatic HTTPS reverse proxy for Solo Speaker.
# DOMAIN and ACME_EMAIL are provided at runtime by docker-compose (the deploy env).
{
	email {$ACME_EMAIL}
}

# Canonical host serves the app.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# www permanently redirects to the canonical apex (matches NEXT_PUBLIC_SITE_URL).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
